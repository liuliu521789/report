# API 端口（默认 3001）。请勿改为 3000：3000 预留给 admin 的 Vite 开发服务器，前后端必须分端口。
PORT=3001
# 若确需在 3000 上跑仅后端（无前端），可设 ALLOW_API_ON_ADMIN_DEV_PORT=true
NODE_ENV=development
# 监听地址：默认 0.0.0.0 便于局域网手机访问；仅本机可设 127.0.0.1
# LISTEN_HOST=0.0.0.0

# ==================== 生产安全基线（强制校验） ====================
# 生产环境 (NODE_ENV=production) 启动时会硬校验以下配置，命中弱配置直接拒绝启动
# - JWT_SECRET: 必须 >=32 字符且非示例值
# - MYSQL_PASSWORD: 长度 >=12 且非弱密码
# - ENABLE_API_DOCS: 必须为 false
# - PUBLIC_BASE_URL: 推荐使用 https://
# 详见 TECHNICAL.md 部署章节
ENABLE_API_DOCS=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=admin
MYSQL_DATABASE=qc_report
# 可选：mysqldump 绝对路径（Windows 下 Node 进程无 PATH 而找不到 mysqldump 时配置）
# MYSQLDUMP_PATH=C:\\Program Files\\MySQL\\MySQL Server 8.0\\bin\\mysqldump.exe
JWT_SECRET=abc123xyz789QwErTyUiOpAsDfGhJkLzXcVbNm9876543210
BACKUP_ROOT=/backup
BACKUP_CRON=0 2 * * *
BACKUP_ENABLED=true
# 定时备份后自动做可恢复性校验（建议开启）
BACKUP_VERIFY_AFTER_CRON=true
# 说明：backup-cron 日志已是 JSON 行格式，可直接采集到 ELK/Loki
# 备份保留天数（0=不自动清理）
BACKUP_RETENTION_DAYS=30
# 备份失败告警：企业微信机器人 webhook（可选）
# BACKUP_ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# 机器人告警级别阈值：off=关闭，error=错误及以上，critical=仅严重
BACKUP_ALERT_LEVEL=error
# 同类告警限频窗口（分钟）：0=不去重，默认 10 分钟
BACKUP_ALERT_DEDUP_MINUTES=10
# 备份包加密密钥（可选；配置后下载包会变为 .enc，需同密钥才能解密恢复）
# BACKUP_ENCRYPTION_KEY=please_change_to_a_long_random_secret
# 密钥轮换过渡：旧密钥列表（逗号分隔），用于读取历史加密包；完成重加密后可清空
# BACKUP_ENCRYPTION_KEY_OLD=old_secret_1,old_secret_2
# 扫码链接域名（须与手机可达地址一致）。二维码入口为 /api/public/qr/...，若反代只转发 /api/*，须包含 /api 路径。
# 企业微信「完成发货」须 HTTPS + 已备案域名并加入应用「可信网页域名」；http/内网/IP 在内置浏览器中常提示无法打开。
# 后台填写「可信域名」时：只填主机名（如 report.example.com），不要带 https:// 等协议头；不支持 IP 地址及短链域名。
# 固定子域名穿透本机 3001（便于本地联调企微）：① Cloudflare Tunnel——域名在 Cloudflare，cloudflared 将公网子域映射到 http://127.0.0.1:3001，边缘 HTTPS；
#   企微可信域名填该子域主机名，PUBLIC_BASE_URL=https://该子域（无尾斜杠）。② frp——域名指向 VPS，VPS 上 Nginx/Let's Encrypt 终结 HTTPS，frp 转发到开发机 3001；
#   可信域名与 PUBLIC_BASE_URL 的 host 必须与对外 HTTPS 一致；回调 URL 须能被企微服务器访问。
PUBLIC_BASE_URL=http://192.168.110.6:3001
# 台账 Excel 导入：从服务器读取时的目录（默认仓库根目录 public/）
# QC_YEARBOOK_PUBLIC_DIR=D:/report/public
# 管理后台在浏览器中的访问根（与 API 同域时可省略）。若静态页与 API 不同域名，须设置此项，否则企业微信「财务审核」引导页的「打开订单管理」会指错地址。
# ADMIN_PUBLIC_URL=https://report.example.com
# 本地/内网调试「完成发货」确认页：暂无法使用企微可信域名与网页授权时，可设 true 跳过 OAuth 与仓库身份 Cookie（削弱安全，禁止用于生产）。
# WECOM_SHIP_OAUTH_DISABLED=true
# 本地/内网调试「合同审批」公开页：暂无法使用企微网页授权时，可设 true 跳过 OAuth 身份校验（削弱安全，禁止用于生产）。
# WECOM_CONTRACT_REVIEW_OAUTH_DISABLED=true
# 企业微信「接收消息」回调调试：解密后的 XML 打印到控制台（勿在生产开启）
# WECOM_CALLBACK_DEBUG=1
# 异步企业微信通知 worker（默认开启；多实例部署时可仅在一台开启，其余设 true）
# WECOM_NOTIFY_WORKER_DISABLED=false
# WECOM_NOTIFY_WORKER_MS=5000
# 企业微信 Secret/回调凭据 AES-256-GCM 加密（32 字节随机密钥的 Base64）；不设则仍以明文落库
# APP_ENCRYPTION_KEY=
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_ENABLED=true

# 账号模块加固相关：
# 初始化超管接口（/api/auth/bootstrap-admin）：仅在 users 表为空时可匿名调用，
# 默认仅本机 IP 可访问；如需远程初始化请显式设为 true，部署完毕务必关闭。
ALLOW_BOOTSTRAP=false
# 登录类接口限流总开关：仅在你确认外部网关已限流时再设为 true（默认开启限流）
DISABLE_LOGIN_RATE_LIMIT=false
# 会话守卫缓存 TTL（毫秒），停用账号/改密生效延迟最大值；默认 15s
SESSION_GUARD_TTL_MS=15000

