PORT=3001
# 监听地址：默认 0.0.0.0 便于局域网手机访问；仅本机可设 127.0.0.1
# LISTEN_HOST=0.0.0.0
# 是否启用 Swagger UI（/api-docs）与 /openapi.yaml；生产环境建议 false
ENABLE_API_DOCS=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=admin
MYSQL_DATABASE=qc_report
JWT_SECRET=abc123xyz789QwErTyUiOpAsDfGhJkLzXcVbNm9876543210
# 扫码链接域名（须与手机可达地址一致）。二维码入口为 /api/public/qr/...，若反代只转发 /api/*，须包含 /api 路径。
# 企业微信「完成发货」须 HTTPS + 已备案域名并加入应用「可信网页域名」；http/内网/IP 在内置浏览器中常提示无法打开。
PUBLIC_BASE_URL=http://192.168.110.6:3001
# 企业微信「接收消息」回调调试：解密后的 XML 打印到控制台（勿在生产开启）
# WECOM_CALLBACK_DEBUG=1
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_ENABLED=true

